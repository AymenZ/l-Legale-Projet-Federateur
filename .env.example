# Gabarit des variables d'environnement. Copier : cp .env.example .env
# Ne JAMAIS commiter .env (ignoré par .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=federateur_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Adminer ---
ADMINER_PORT=8080

# --- Backend FastAPI (Séance 4) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_this_secret_key_min_32_chars
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Brique IA (Séance 3) ---
LLM_PROVIDER=ollama
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=llama3.1:8b
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5

# --- Frontend Vite (Séance 5) ---
VITE_API_URL=http://localhost:8000/api
